{
  "expo": {
    "name": "Fond de Caisse",
    "slug": "fdc-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fdcmobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.npgandour.fdc",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.npgandour.fdc",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F4C81"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "http://10.10.32.2:8080/api/v1",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2e3aca4e-ad91-4b27-bd83-88a0a49cabaa"
      }
    },
    "owner": "yannick.atse"
  }
}
